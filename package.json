{
  "name": "sme-trust-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "tsx tests/thai.test.mts && tsx tests/flows.test.mts && tsx tests/ai.test.mts && tsx tests/scenarios.test.mts && tsx tests/workflows.test.mts && tsx tests/v2/marketplace.test.mts && tsx tests/v2/assessment.test.mts && tsx tests/v2/workflows.test.mts && tsx tests/v2/ui.test.mts && tsx tests/render.test.mts",
    "test:flows": "tsx tests/flows.test.mts",
    "test:scenarios": "tsx tests/scenarios.test.mts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:safari": "playwright test --project=webkit --project=iphone-safari --project=ipad-safari --workers=2",
    "test:e2e:subpath": "node scripts/e2e-subpath.mjs",
    "postbuild": "node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "build:v2": "tsc -b && vite build --base /sme-trust/v2/ --outDir dist-v2 --emptyOutDir && node -e \"require('fs').copyFileSync('dist-v2/index.html','dist-v2/404.html')\""
  },
  "dependencies": {
    "@fontsource/noto-sans-thai": "^5.1.0",
    "@hookform/resolvers": "^3.9.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.460.0",
    "qrcode.react": "^4.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.2",
    "react-router-dom": "^6.28.0",
    "recharts": "^2.13.3",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
