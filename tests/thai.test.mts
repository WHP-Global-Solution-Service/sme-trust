/**
 * ตรวจคำภาษาไทยในข้อความที่แสดงบนหน้าจอ (สตริงและข้อความ JSX ใน src/)
 * — คำที่มักสะกดผิด, คำทับศัพท์ตามหลักราชบัณฑิตยสภา, การเว้นวรรค และคำลงท้าย
 * ไม่ตรวจ Regex ของกฎ AI (ต้องรองรับคำที่ผู้ใช้พิมพ์ผิดหรือสะกดแบบอื่น)
 */
import fs from 'node:fs';
import path from 'node:path';
import { check, describe, finish } from './harness.mts';

const RULES: [RegExp, string][] = [
  [/อนุญาติ/, 'อนุญาต'],
  [/ผลลัพท์/, 'ผลลัพธ์'],
  [/โอกาศ/, 'โอกาส'],
  [/สังเกตุ/, 'สังเกต'],
  [/ปรากฎ/, 'ปรากฏ'],
  [/(?<![ากา])กฏ/, 'กฎ'],
  [/เกณท์/, 'เกณฑ์'],
  [/ลายเซ็นต์/, 'ลายเซ็น'],
  [/อีเมล์/, 'อีเมล'],
  [/เว็บไซท์/, 'เว็บไซต์'],
  [/คลิ๊ก/, 'คลิก'],
  [/เช็ค(?!อิน)/, 'เช็ก'],
  [/แชท/, 'แชต'],
  [/อัพเดท|อัพเดต|อัปเดท/, 'อัปเดต'],
  [/อัพโหลด/, 'อัปโหลด'],
  [/แอพ/, 'แอป'],
  [/แอปพลิเคชั่น/, 'แอปพลิเคชัน'],
  [/โปรโมชั่น/, 'โปรโมชัน'],
  [/ดิจิตอล/, 'ดิจิทัล'],
  [/ซอฟท์แวร์/, 'ซอฟต์แวร์'],
  [/อาราบิก้า/, 'อาราบิกา'],
  [/กระพริบ/, 'กะพริบ'],
  [/รสชาด/, 'รสชาติ'],
  [/นะค่ะ/, 'นะคะ'],
  [/ค่ะ\?/, 'คะ? (คำถามใช้ คะ)'],
  [/[ก-๙]ๆ/, 'เว้นวรรคก่อน ๆ'],
  [/ๆ[ก-๙]/, 'เว้นวรรคหลัง ๆ'],
  [/เเ/, 'ใช้ แ ไม่ใช่ เ สองตัว'],
  [/ํา/, 'ใช้สระอำ (ำ) ไม่ใช่ ํ + า'],
  [/​/, 'มี Zero-width space'],
  [/[ก-๙] {2,}[ก-๙]/, 'เว้นวรรคซ้ำ'],
  [/[ก-๙] & [ก-๙]/, 'ใช้ "และ" แทน "&" ในข้อความภาษาไทย'],
  [/เรื่องเรื่อง|ที่ที่ |การการ/, 'คำซ้ำ'],
];

const files: string[] = [];
const walk = (d: string) =>
  fs.readdirSync(d, { withFileTypes: true }).forEach((e) => (e.isDirectory() ? walk(path.join(d, e.name)) : /\.tsx?$/.test(e.name) && files.push(path.join(d, e.name))));
walk('src');

describe('พิสูจน์อักษรภาษาไทย (ข้อความบนหน้าจอ)');
const problems: string[] = [];
let strings = 0;
for (const f of files) {
  if (/ai-assistant[\\/]rules[\\/]|utils[\\/]screening\.ts$/.test(f)) continue; // คำสำคัญของกฎ ไม่ใช่ข้อความแสดงผล
  fs.readFileSync(f, 'utf8')
    .split('\n')
    .forEach((line, i) => {
      if (/^\s*(\/\/|\*|\/\*)/.test(line) || /patterns?:\s*\[|new RegExp/.test(line)) return;
      for (const m of line.matchAll(/'([^'\n]*[ก-๙][^'\n]*)'|"([^"\n]*[ก-๙][^"\n]*)"|`([^`\n]*[ก-๙][^`\n]*)`|>([^<>{}\n]*[ก-๙][^<>{}\n]*)</g)) {
        const text = m[1] ?? m[2] ?? m[3] ?? m[4];
        if (/^\/.*\/[gimsuy]*$/.test(text)) continue;
        strings++;
        for (const [re, fix] of RULES) {
          const hit = text.match(re);
          if (hit) problems.push(`${f.split(path.sep).join('/')}:${i + 1} "${hit[0]}" → ${fix}`);
        }
      }
    });
}
check(strings > 1500, `ตรวจข้อความภาษาไทย ${strings} ข้อความจาก ${files.length} ไฟล์`);
check(problems.length === 0, `ไม่พบคำสะกดผิด/ทับศัพท์ไม่ตรงหลัก/เว้นวรรคผิด ${RULES.length} กฎ${problems.length ? '\n    ' + problems.slice(0, 15).join('\n    ') : ''}`);

// คำศัพท์สำคัญต้องใช้ตรงกันทุกหน้าจอ
const all = files.map((f) => fs.readFileSync(f, 'utf8')).join('\n');
check(!/เพิกถอนคำสั่ง —/.test(all) && /รับอุทธรณ์ — คืนสถานะการรับรอง/.test(all), 'ผลอุทธรณ์ใช้คำเดียวกันทุกมุมมอง: "รับอุทธรณ์ / ยกอุทธรณ์" (ไม่ใช้ "เพิกถอนคำสั่ง" ซึ่งสับสนกับการเพิกถอนการรับรอง)');
check(!/Revoked \+/.test(all), 'ป้ายบัญชีสาธิตเป็นภาษาไทย');

finish();
